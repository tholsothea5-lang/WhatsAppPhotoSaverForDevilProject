{
  "manifest_version": 3,
  "name": "WhatsApp Photo Saver",
  "version": "1.2.0",
  "description": "Save WhatsApp Web photo albums into folders by album caption/next text message. Nothing uploaded.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "action": {
    "default_title": "WhatsApp Photo Saver"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "icons": {
    "128": "icon128.png"
  }
}
